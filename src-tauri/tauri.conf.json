{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Translate",
  "version": "0.1.0",
  "identifier": "com.llmtranslate.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LLM Translate",
        "width": 960,
        "height": 640,
        "minWidth": 560,
        "minHeight": 420,
        "transparent": true,
        "center": true,
        "visible": false,
        "create": false
      },
      {
        "label": "wizard",
        "title": "LLM Translate · 一键部署",
        "width": 760,
        "height": 580,
        "minWidth": 680,
        "minHeight": 520,
        "transparent": true,
        "center": true,
        "visible": false,
        "create": false
      },
      {
        "label": "mini",
        "title": "LLM Translate · 迷你翻译",
        "width": 620,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "create": false
      },
      {
        "label": "popup",
        "title": "LLM Translate · 划词翻译",
        "width": 440,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "create": false
      },
      {
        "label": "shot",
        "title": "LLM Translate · 截图翻译",
        "width": 400,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/llama/*": "llama/",
      "resources/ocr/*": "ocr/",
      "resources/models.json": "models.json"
    }
  }
}