{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Translate",
  "version": "0.1.6",
  "identifier": "com.llmtranslate.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LLM Translate",
        "width": 1000,
        "height": 660,
        "minWidth": 620,
        "minHeight": 460,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "visible": false,
        "create": false
      },
      {
        "label": "wizard",
        "title": "LLM Translate · 一键部署",
        "width": 780,
        "height": 600,
        "minWidth": 680,
        "minHeight": 540,
        "decorations": false,
        "transparent": true,
        "maximizable": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "create": false
      },
      {
        "label": "mini",
        "title": "LLM Translate · 迷你翻译",
        "width": 640,
        "height": 68,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "create": false
      },
      {
        "label": "popup",
        "title": "LLM Translate · 划词翻译",
        "width": 440,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "create": false
      },
      {
        "label": "shot",
        "title": "LLM Translate · 截图翻译",
        "width": 400,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LLM Translate",
    "shortDescription": "本地大模型中英互译",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/llama/*": "llama/",
      "resources/ocr/*": "ocr/",
      "resources/models.json": "models.json",
      "resources/runtime/*": "./"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1MTVCRUQ1OTlGMjU1MTcKUldRWFZmS1oxYjRWRmNvZCtmbXB3REZSMHBQTHlXekxKSjJxSVFmN251Q2syN3M3K0hKUlJQU3MK",
      "endpoints": [
        "https://github.com/liudg/llm-translate/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}